@using KnowledgeOps.Web.Models.Copilot
@model KnowledgeOps.Web.Models.Documents.DocumentDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
    <a class="text-decoration-none"
       asp-controller="Documents"
       asp-action="Index">
        &larr; Back to Documents
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <p class="text-muted small mb-1">@Model.Id</p>
                        <h1 class="h3 mb-0">@Model.Title</h1>
                    </div>
                    <span class="badge @Model.StatusCssClass">
                        @Model.StatusLabel
                    </span>
                </div>

                <p class="lead">@Model.Summary</p>

                <hr />

                <dl class="row">
                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Category</dd>

                    <dt class="col-sm-3">Department</dt>
                    <dd class="col-sm-9">@Model.Department</dd>

                    <dt class="col-sm-3">Owner</dt>
                    <dd class="col-sm-9">@Model.Owner</dd>

                    <dt class="col-sm-3">Last Reviewed</dt>
                    <dd class="col-sm-9">@Model.LastReviewedOn.ToString("MMMM d, yyyy")</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.ContentType))
                    {
                        <dt class="col-sm-3">Content Type</dt>
                        <dd class="col-sm-9">@Model.ContentType</dd>
                    }

                    @if (Model.FileSizeBytes is not null)
                    {
                        <dt class="col-sm-3">File Size</dt>
                        <dd class="col-sm-9">@FormatBytes(Model.FileSizeBytes.Value)</dd>
                    }
                </dl>

                <div class="mt-4">
                    <h2 class="h6">Tags</h2>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="badge text-bg-light border">@tag</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var assistantContext = new CopilotPageContext
    {
        Area = "Documents",
        PageTitle = Model.Title,
        EntityType = "Document",
        EntityId = Model.Id,
        Summary = Model.Summary,
        Metadata = new Dictionary<string, string>
        {
            ["Category"] = Model.Category,
            ["Department"] = Model.Department,
            ["Owner"] = Model.Owner,
            ["Status"] = Model.StatusLabel,
            ["LastReviewedOn"] = Model.LastReviewedOn.ToString("yyyy-MM-dd"),
            ["Tags"] = string.Join(", ", Model.Tags)
        }
    };

    if (!string.IsNullOrWhiteSpace(Model.ContentType))
    {
        assistantContext.Metadata["ContentType"] = Model.ContentType;
    }

    if (Model.FileSizeBytes is not null)
    {
        assistantContext.Metadata["FileSize"] = FormatBytes(Model.FileSizeBytes.Value);
    }
}
<partial name="_AssistantContext" model="assistantContext" />
   
@functions {
    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        decimal kilobytes = bytes / 1024m;

        if (kilobytes < 1024)
        {
            return $"{kilobytes:0.#} KB";
        }

        decimal megabytes = kilobytes / 1024m;
        return $"{megabytes:0.#} MB";
    }
}
