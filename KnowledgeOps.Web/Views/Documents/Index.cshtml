@model IReadOnlyList<KnowledgeOps.Web.Models.Documents.DocumentListItemViewModel>

@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="mb-1">Documents</h1>
        <p class="text-muted mb-0">
            Review managed business documents that can later be used for grounded AI assistance.
        </p>
    </div>
    <span class="badge text-bg-primary">Knowledge Base</span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Documents"
              asp-action="Upload"
              method="post"
              enctype="multipart/form-data"
              class="row g-3 align-items-end">

            <div class="col-md-5">
                <label for="File" class="form-label">Upload PDF document</label>
                <input id="File"
                       name="File"
                       class="form-control"
                       type="file"
                       accept="application/pdf,.pdf" />
                <div class="form-text">
                    Upload a PDF that can later be processed for grounded AI assistance.
                </div>
            </div>

            <div class="col-md-5">
                <label for="Tags" class="form-label">Tags</label>
                <input id="Tags"
                       name="Tags"
                       class="form-control"
                       placeholder="hr, onboarding, policy" />
                <div class="form-text">
                    Optional comma-separated tags for filtering and retrieval metadata.
                </div>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Upload
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No documents have been uploaded yet. Upload a PDF to begin the document intelligence workflow.
    </div>
}
else
{
<div class="row g-4">
    @foreach (KnowledgeOps.Web.Models.Documents.DocumentListItemViewModel document in Model)
    {
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h5 mb-1">@document.Title</h2>
                            <p class="text-muted small mb-2">@document.Id</p>
                        </div>
                        <span class="badge @document.StatusCssClass">
                            @document.StatusLabel
                        </span>
                    </div>

                    <p class="mb-3">@document.Summary</p>

                    <dl class="row small mb-0">
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@document.Category</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@document.Department</dd>

                        <dt class="col-sm-4">Reviewed</dt>
                        <dd class="col-sm-8">@document.LastReviewedOn.ToString("MMM d, yyyy")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent">
                    <a class="btn btn-outline-primary btn-sm"
                       asp-controller="Documents"
                       asp-action="Details"
                       asp-route-id="@document.Id">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>
}