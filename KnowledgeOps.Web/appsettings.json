{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=knowledgeops.db"
  },
  "CopilotHistory": {
    "MaxModelMessages": 8,
    "MaxDisplayMessages": 50,
    "SummarizeAfterMessages": 16,
    "MessagesToKeepAfterSummary": 8,
    "ConversationRelevanceHours": 24,
    "RetentionDays": 10,
    "CleanupIntervalDays": 10
  },
  "DocumentUpload": {
    "StoragePath": "App_Data/Uploads/Documents",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf"
    ],
    "AllowedExtensions": [
      ".pdf"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
